# Local development
VITE_API_URL=http://localhost:8000
VITE_MODEL_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws/signals

# Set true only when VITE_API_URL points to an ngrok free-tier endpoint.
# The backend CORS policy explicitly supports this opt-in header.
VITE_NGROK_BYPASS=false

# Production builds must set these variables to the deployed ECG backend.
# Do not use localhost or the retired bioelectric-backend.onrender.com endpoint.
